rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'admin@u-coffee.app';
    }
    match /schedule_shifts_v2/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /schedule_prefs_v2/{document} {
      allow read, write: if true;
    }
    match /logs_v2/{document} {
      allow read: if true;
      allow create: if isAdmin();
      allow update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
